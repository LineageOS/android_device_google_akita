<compatibility-matrix version="9.0" type="framework">
    <hal format="aidl">
        <name>android.hardware.gnss</name>
        <version>3</version>
        <interface>
            <name>IGnss</name>
            <instance>vendor</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.google.aam</name>
        <version>1-3</version>
        <interface>
            <name>IAam</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.google.radio_ext</name>
        <interface>
            <name>IRadioExt</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
